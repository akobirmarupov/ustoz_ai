# @BotFather dan olingan token
BOT_TOKEN=

# Admin(lar) Telegram ID si, vergul bilan: 123456789,987654321
ADMINS=

# PostgreSQL (tavsiya): postgresql+asyncpg://user:parol@localhost:5432/ustoz_elite
# Bo'sh qoldirilsa, sinov uchun SQLite fayl ishlatiladi
DATABASE_URL=

# Claude API kaliti: https://console.anthropic.com
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# Vaqtincha: ANTHROPIC_API_KEY bo'sh bo'lsa Gemini ishlatiladi (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# To'lov kartasi
CARD_NUMBER=8600 0000 0000 0000
CARD_OWNER=Ism Familiya

# Yordam uchun username (@ belgisisiz)
SUPPORT_USERNAME=

# Bir vaqtda nechta fayl tayyorlansin
WORKERS=2
